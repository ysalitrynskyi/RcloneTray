{
  "name": "rclonetray",
  "productName": "RcloneTray",
  "title": "RcloneTray",
  "version": "1.8.0",
  "releaseType": "release",
  "description": "Simple Rclone bookmark manager GUI that stays in the system tray.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysalitrynskyi/RcloneTray"
  },
  "keywords": [
    "Tray",
    "Mount",
    "Rclone",
    "Connect",
    "Remote Filesystem",
    "Network",
    "Utilities"
  ],
  "author": "Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>",
  "bugs": {
    "url": "https://github.com/ysalitrynskyi/RcloneTray/issues"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "fetch-rclone": "node scripts/fetch-rclone.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:publish": "npm run build && electron-builder -p always --mac --win --linux --x64",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.github.ysalitrynskyi.rclonetray",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "src/ui"
    ],
    "asar": true,
    "beforePack": "scripts/stage-rclone.js",
    "asarUnpack": [
      "src/ui/icons/*"
    ],
    "compression": "normal",
    "mac": {
      "category": "public.app-category.utilities",
      "type": "distribution",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "zip",
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publish": [
        "github"
      ],
      "extraResources": [
        {
          "from": "rclone/staged",
          "to": "rclone"
        },
        "rclone/LICENSE"
      ],
      "darkModeSupport": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publish": [
        "github"
      ],
      "extraResources": [
        {
          "from": "rclone/staged",
          "to": "rclone"
        },
        "rclone/LICENSE"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publish": [
        "github"
      ],
      "extraResources": [
        {
          "from": "rclone/staged",
          "to": "rclone"
        },
        "rclone/LICENSE"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "ini": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/ini": "^4.1.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "3.2.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-reload": "^1.5.0",
    "eslint": "9.39.5",
    "playwright": "^1.40.0",
    "typescript": "^5.3.2",
    "vitest": "3.2.7"
  },
  "rcloneVersion": "v1.74.4",
  "engines": {
    "node": ">=22.12"
  }
}
